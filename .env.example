# Copier ce fichier en .env.local et compléter
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# (les noms NEXT_PUBLIC_SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont aussi acceptés)
SUPABASE_SECRET_KEY=
# Code d'accès demandé à l'ouverture du site. Vide = le code écrit dans lib/access.ts.
APP_PASSWORD=
# Adresse publique du site, utilisée dans le lien de signature des e-mails (ex. https://gestion.exemple.fr).
# Vide = l'adresse depuis laquelle l'e-mail est envoyé.
APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Envoi d'e-mails par SMTP (bons de commande, messages de livraison)
# Laisser SMTP_HOST vide = pas d'envoi (les aperçus restent consultables).
# ─────────────────────────────────────────────────────────────────────────────
# Serveur d'envoi de votre messagerie
#   Gmail : smtp.gmail.com      OVH : ssl0.ovh.net      Outlook / Microsoft 365 : smtp.office365.com
#   IONOS : smtp.ionos.fr       Orange : smtp.orange.fr
SMTP_HOST=
# Port : 587 (STARTTLS, le plus courant) ou 465 (SSL)
SMTP_PORT=587
# Mettre true uniquement avec le port 465 ; laisser vide sinon (déduit du port)
SMTP_SECURE=
# Identifiant : en général l'adresse e-mail complète de la boîte
SMTP_USER=
# Mot de passe de la boîte. Gmail : créer un « mot de passe d'application » (compte Google > Sécurité)
SMTP_PASSWORD=
# Expéditeur affiché chez le client (doit correspondre à la boîte ci-dessus)
MAIL_FROM="Votre Société <contact@exemple.fr>"
# Adresse qui reçoit les réponses des clients (facultatif)
MAIL_REPLY_TO=
# Copie cachée de chaque e-mail envoyé, pour garder une trace (facultatif)
MAIL_BCC=
